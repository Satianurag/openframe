# The studio binds to localhost. Keep credentials out of exported workflows.
OPENFRAME_DATA_DIR=.openframe
OPENFRAME_COMFY_URL=http://127.0.0.1:8188
OPENFRAME_COMFY_CLOUD_URL=https://cloud.comfy.org
OPENFRAME_DEFAULT_PROVIDER=local
# Optional bearer key for a protected self-hosted Comfy endpoint:
# OPENFRAME_COMFY_API_KEY=
# OPENFRAME_COMFY_CLOUD_API_KEY=
# Maximum individual uploaded media file in MiB:
OPENFRAME_MAX_UPLOAD_MB=512
# Comma-separated browser origins permitted to call the local API:
OPENFRAME_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
# Optional installed comfy-cli executable; empty auto-detects PATH/uv tool installs.
OPENFRAME_COMFY_CLI_PATH=
# Optional libass-enabled FFmpeg for caption burn-in. Auto-detects ffmpeg-full on macOS.
# OPENFRAME_CAPTION_FFMPEG=/opt/homebrew/opt/ffmpeg-full/bin/ffmpeg
